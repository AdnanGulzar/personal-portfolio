# Copy this file to .env.local, fill in what you need, then restart `npm run dev`.
# On GitHub Pages these are set by .github/workflows/deploy.yml instead.

# Contact form — free access key from https://web3forms.com (enter the inbox that should receive messages).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Cloudflare Web Analytics token (cookieless, free): dash.cloudflare.com → Analytics & Logs → Web Analytics
# → Add a site → copy the "token" value from the JS snippet. Leave empty to disable.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Google Search Console "HTML tag" verification — paste only the content="…" value.
NEXT_PUBLIC_GSC_VERIFICATION=

# Public origin used for canonical URLs, sitemap and social previews (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://adnangul.com
